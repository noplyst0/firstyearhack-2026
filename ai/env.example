# Copy to ai/.env and fill in. ai/.env is gitignored: never commit it.
# (Named env.example, not .env.example, because .gitignore ignores .env.*)
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=SKYSKETCH_WH
SNOWFLAKE_DATABASE=SKYSKETCH
SNOWFLAKE_SCHEMA=GAME
