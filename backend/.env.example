# Copy to backend/.env (never commit .env). SNOWFLAKE_ENABLED=0 forces local scoring.
SNOWFLAKE_ENABLED=1
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# or instead of a password:
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=SKY_WH
SNOWFLAKE_DATABASE=SKYSKETCH
SNOWFLAKE_SCHEMA=GAME
SNOWFLAKE_MODEL=
SNOWFLAKE_VISION_MODEL=
# optional
PORT=3000
